# Copy to .env and adjust. Nothing here is a secret by default.

# --- Storage -----------------------------------------------------------------
POSTGRES_USER=hontology
POSTGRES_PASSWORD=hontology
POSTGRES_DB=hontology
POSTGRES_PORT=5435
HONTOLOGY_DATABASE_URL=postgresql+psycopg://hontology:hontology@localhost:5435/hontology

# Where run artifacts, the scrape cache and the DuckDB warehouse live.
HONTOLOGY_DATA_DIR=./data

# --- API ---------------------------------------------------------------------
HONTOLOGY_API_HOST=127.0.0.1
HONTOLOGY_API_PORT=8100
# The Streamlit UI is a pure HTTP client; this is the only way it reaches data.
HONTOLOGY_API_BASE_URL=http://127.0.0.1:8100

# --- Providers ---------------------------------------------------------------
# Transport addresses are infrastructure: they are recorded in a run manifest but
# deliberately excluded from the run's config hash, so moving hosts does not look
# like a new experiment.
HONTOLOGY_OLLAMA_HOST=http://localhost:11434
# ANTHROPIC_API_KEY=

# Defaults for a new run config. These ARE behavior, so they are hashed.
HONTOLOGY_DEFAULT_JUDGE_PROVIDER=ollama
HONTOLOGY_DEFAULT_JUDGE_MODEL=huihui_ai/qwen3.5-abliterated:9b
HONTOLOGY_DEFAULT_EMBED_PROVIDER=ollama
HONTOLOGY_DEFAULT_EMBED_MODEL=nomic-embed-text

# --- Ingest ------------------------------------------------------------------
HONTOLOGY_GDELT_BASE_URL=https://data.gdeltproject.org/gdeltv2
# Identify the crawler honestly to the sites being fetched.
HONTOLOGY_SCRAPE_USER_AGENT=hontology/0.1 (+https://github.com/emaroppo/hontology)
HONTOLOGY_SCRAPE_MAX_CONCURRENCY=8
HONTOLOGY_SCRAPE_PER_HOST_DELAY_S=1.0
HONTOLOGY_SCRAPE_TIMEOUT_S=20.0
# Hard ceiling on articles fetched per ingest run, so a stray backfill cannot
# turn into an unbounded crawl.
HONTOLOGY_SCRAPE_BUDGET=500
